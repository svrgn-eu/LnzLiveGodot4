; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PetzRendering"
config/version="1.0.0"
run/main_scene="res://Scenes/Editor/Editor.tscn"
config/features=PackedStringArray("4.8", "C#")
config/icon="res://icon.png"

[autoload]

ServiceBootstrapper="*res://Core/ServiceBootstrapper.cs"

[debug]

gdscript/warnings/shadowed_variable=false

[display]

window/size/viewport_height=768
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="PetzRendering"

[gui]

theme/custom="res://resources/themes/editor_theme.tres"

[input]

save_file={
"deadzone": 0.2,
"events": [Object(InputEventKey,
"resource_local_to_scene": false,
"resource_name": "",
"device": -1,
"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": true,
"meta_pressed": false,
"pressed": false,
"keycode": 83,
